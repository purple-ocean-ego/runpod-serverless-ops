FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_BREAK_SYSTEM_PACKAGES=1

# ==============================================================================
# ComfyUI ローカル開発環境 (GTX 1660 / Turing 向け)
# ==============================================================================
# RunPod用の runpod/base とは完全に独立したクリーンなイメージ。
# PyTorch と ComfyUI の依存パッケージをイメージに焼き込み、
# 起動時のセットアップ時間を最小化する。

# システムパッケージ (ComfyUIの前提ライブラリ群)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev python3-pip \
    git curl ffmpeg \
    libgl1 libglib2.0-0 \
    sox libsox-dev \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# uv のインストール
RUN pip3 install --no-cache-dir --break-system-packages uv

# PyTorch (cu126) をイメージに焼き込み
# GTX 1660 (Turing, CC 7.5) / RTX 3090 (Ampere, CC 8.6) 両対応
RUN uv pip install --system --no-cache-dir \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu126

# ComfyUI の主要な依存パッケージを焼き込み
# (local/requirements.txt の内容から torch 系を除いたもの)
# ComfyUIのバージョンアップが激しいため、重いパッケージはここでキャッシュしておく
RUN uv pip install --system --no-cache-dir \
    comfyui-frontend-package comfyui-workflow-templates comfyui-embedded-docs \
    torchsde \
    "numpy>=1.25.0" einops \
    "transformers>=4.50.3" "tokenizers>=0.13.3" sentencepiece \
    "safetensors>=0.4.2" \
    "aiohttp>=3.11.8" "yarl>=1.18.0" \
    pyyaml Pillow scipy tqdm psutil \
    alembic SQLAlchemy filelock \
    "av>=14.2.0" "comfy-kitchen>=0.2.8" "comfy-aimdo>=0.2.12" \
    requests "simpleeval>=1.0.0" blake3 \
    "kornia>=0.7.1" spandrel \
    "pydantic~=2.0" "pydantic-settings~=2.0" \
    PyOpenGL glfw \
    huggingface_hub

WORKDIR /workspace

EXPOSE 8188

CMD ["bash", "/scripts/setup_local.sh"]
